# Copy to .env and fill in, then: chmod 600 .env
# One NAME=value per line. Quotes around a value are optional and removed; quote a value whose spaces matter.
PORT=3610

# App login password. Long and random: anyone who has it can run Claude/Codex on this box.
POCKET_PASSWORD=change-me
# Cookie-signing secret: openssl rand -hex 32
POCKET_SECRET=change-me

# Push notifications (optional): npx web-push generate-vapid-keys --json
VAPID_PUBLIC=
VAPID_PRIVATE=
# Contact for push services: an email address or an https URL
VAPID_CONTACT=you@example.com

# ---- Optional ----
# Permission mode for turns without an explicit choice: review (default) or full.
# POCKET_APPROVAL_MODE=review
# Set 0 to disallow Full access through this instance's API/UI.
# POCKET_ALLOW_FULL_ACCESS=0
# Read-only actions Claude runs without an approval card in Review actions, until Settings →
# Agents & instance → Actions that run without asking saves a list (default: none, every action asks).
# Commas or one rule per line: Bash(command:*), Bash(exact command), mcp__server__tool, mcp__server__*, WebSearch.
# POCKET_TRUSTED_ACTIONS=Bash(techpro-lookup:*),mcp__memstem__*
# Path to the claude binary, if it isn't found automatically
# CLAUDE_BIN=/usr/bin/claude
# Codex sessions turn on automatically when the codex CLI is installed. Set 0 to hide them.
# POCKET_CODEX=0
# CODEX_BIN=/usr/local/bin/codex
# CODEX_HOME=~/.codex
# Pocket-only defaults for turns left on Default (terminal sessions keep the CLI config)
# POCKET_CLAUDE_MODEL=claude-opus-5-5[1m]
# Claude models the picker offers until Settings → Agents & instance chooses (default: all).
# Claude Code's managed availableModels/deniedModels are always honoured on top.
# POCKET_CLAUDE_MODELS=claude-sonnet-5-5,claude-opus-5-5[1m]
# POCKET_CLAUDE_EFFORT=high
# POCKET_CODEX_MODEL=gpt-6-sol
# POCKET_CODEX_EFFORT=medium
# Workspace the New session screen preselects (default: the last one you used)
# POCKET_DEFAULT_CWD=/home/you
# After a usage-limit reset, wait this long before auto-continuing (ms, default 5 minutes)
# POCKET_RETRY_BUFFER_MS=300000
# Session process idle close and turn stall watchdog, in milliseconds (0 disables)
# POCKET_IDLE_CLOSE_MS=3600000
# POCKET_STALL_MS=1800000
# Soft process target; reclaims idle sessions, never active work. 0 disables it.
# POCKET_MAX_PROCESSES=8
# Side chat (1.78): 0 turns it off; spending cap per side chat in USD; idle close (ms); how many at once
# POCKET_SIDE_CHAT=1
# POCKET_SIDE_CHAT_BUDGET_USD=5
# POCKET_SIDE_CHAT_IDLE_MS=1800000
# POCKET_SIDE_CHAT_MAX=4
# Origins allowed to embed the app in a frame (space-separated), e.g. Mission Control
# POCKET_FRAME_ANCESTORS=https://monitor.example.com

# Optional absolute directory for Pocket settings, turn logs and delivery receipts.
# Copy existing state before changing this on an existing instance.
# POCKET_DATA_DIR=/var/lib/pocket-code
# Override Claude transcript storage for an isolated test installation.
# POCKET_SESSION_ROOT=/path/to/test-sessions

# Starting value for Settings → Generate short titles (on unless 0). After the first change
# in Settings, the Settings value wins.
# POCKET_AUTO_TITLES=1
# Title models: Claude CLI alias and Codex model id.
# POCKET_TITLE_CLAUDE_MODEL=haiku
# POCKET_TITLE_CODEX_MODEL=gpt-6-luna
# Minimum time between two title checks on one session (Settings → Update titles as sessions
# progress), in milliseconds. Default ten minutes.
# POCKET_LIVE_TITLE_GAP_MS=600000
# Set 0 to stop asking agents for reply suggestions (the buttons under a closing question).
# POCKET_CHOICES=0

# MemStem daemon for searching inside conversations. Default http://127.0.0.1:7821; without a
# healthy MemStem, Pocket searches recent conversations itself. POCKET_MEMSTEM=0 turns it off.
# POCKET_MEMSTEM_URL=http://127.0.0.1:7821
# POCKET_MEMSTEM=0

# ---- Projects, Files, Tasks and the Vault (off until switched on in Settings → Projects, files, tasks & vault) ----
# A command run when a project reminder or a dated task comes due, with the item as JSON on its
# standard input. Each is announced once; web push happens regardless. It runs through a shell
# with the daemon's environment, so use a command you trust.
# POCKET_REMINDER_HOOK=/home/you/bin/notify-me
# Email for due tasks and reminders (1.50): an SMTP address and the sender. The address to send to is set in
# Settings → Notifications & voice. Links use POCKET_PUBLIC_URL, or the address you last signed in from.
# POCKET_SMTP_URL=smtps://you@example.com:app-password@smtp.gmail.com:465
# POCKET_SMTP_FROM=you@example.com
# POCKET_PUBLIC_URL=https://pocket.example.com
# Time zone for times given to pocket-board and pocket-tasks without an offset. Default: the server's zone.
# POCKET_TZ=America/New_York
# Where Files keeps files. Default <data dir>/documents. Removed files wait in its .trash for 30 days.
# POCKET_DOCUMENTS_DIR=/var/lib/pocket-code/documents
# Set 0 to stop Pocket installing its pocket-projects, pocket-files, pocket-tasks and pocket-vault
# agent skills into ~/.claude/skills and $CODEX_HOME/skills. Use it for any test or second daemon.
# POCKET_SKILLS=0
# The Vault's encryption key: 32 random bytes in base64. Generate one with
#   openssl rand -base64 32
# Optional since 1.44: switching the Vault on creates this key and saves it here for you. Pocket removes it from its environment at
# start, so agents never see it. Keep a copy apart from your data backups: without it the Vault's
# store (vault.enc) cannot be opened; the recovery key Pocket shows is that copy. Rotate key and
# Restore key in Settings write this line themselves.
# POCKET_VAULT_KEY=
# Seconds the browser relay (scripts/pocket-mcp-proxy.mjs) waits for your answer to a fill. Default 90.
# POCKET_VAULT_FILL_WAIT=90
# Address the pocket-* commands use to reach the daemon. Default: <data dir>/cli-url, then PORT here.
# POCKET_URL=http://127.0.0.1:3610
# Makes the share addresses pocket-docs prints absolute.
# POCKET_PUBLIC_URL=https://pocket.example.com
# Tools that make the Files library's preview pictures: Chrome or Chromium (HTML reports), pdftoppm
# from poppler (PDFs), ImageMagick convert (images). Found automatically; set a path to choose
# one, or an empty value to turn it off. Pictures are cached in <documents dir>/.thumbs.
# POCKET_CHROME=/usr/bin/chromium
# POCKET_PDFTOPPM=/usr/bin/pdftoppm
# POCKET_CONVERT=/usr/bin/convert

# ---- Voice (optional, beta) ----
# Set to off to disable voice mode even when it is installed.
# POCKET_VOICE=off
# Where scripts/voice-setup.sh installed the voice engine. Default ~/.local/share/pocket-code/voice.
# POCKET_VOICE_HOME=/home/you/.local/share/pocket-code/voice
# How long the voice engine stays loaded after its last use, in milliseconds. Default 900000 (15 minutes).
# POCKET_VOICE_IDLE_MS=900000

# Read settings from another file instead of .env next to the server; empty means read none
# (the test suite does this). Set it in the process environment: it chooses which file is read,
# so it has no effect from inside that file.
# POCKET_ENV_FILE=/etc/pocket-code/env
