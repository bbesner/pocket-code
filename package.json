{
  "name": "pocket-code",
  "version": "1.34.0",
  "private": true,
  "type": "module",
  "bin": {
    "pocket-board": "scripts/pocket-board.mjs",
    "pocket-docs": "scripts/pocket-docs.mjs"
  },
  "description": "Self-hosted Claude Code and Codex workspace for desktop, tablet and phone, with persistent sessions, split conversations and server-side execution.",
  "keywords": [
    "claude-code",
    "codex",
    "pwa",
    "mobile",
    "ai-coding",
    "coding-agent",
    "remote",
    "memstem",
    "desktop-workspace",
    "split-view"
  ],
  "homepage": "https://github.com/bbesner/pocket-code#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbesner/pocket-code.git"
  },
  "bugs": {
    "url": "https://github.com/bbesner/pocket-code/issues"
  },
  "license": "MIT",
  "author": "Brad Besner",
  "engines": {
    "node": ">=20.11"
  },
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser.mjs",
    "vendor": "node scripts/vendor.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "express": "^4.19.0",
    "marked": "18.0.14",
    "web-push": "^3.6.7"
  },
